# LinguaQuest 生产环境模板。复制为 infra/.env.production 后填写，勿提交真实文件或密钥。
# 请使用域名和 HTTPS；Tauri / Android 发布包不能使用裸 IP 或 HTTP API。
DOCKERHUB_USERNAME=your-dockerhub-namespace
CLIENT_IMAGE_TAG=latest
SERVER_IMAGE_TAG=latest
APP_EDITION=COMMERCIAL
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_ADDR=redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
PUBLIC_APP_URL=https://app.example.com
TRUST_PROXY_HEADERS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://your-llm-gateway.example.com/v1
TTS_PROVIDER=XIAOMI
TTS_API_URL=https://token-plan-cn.xiaomimimo.com/v1
TTS_API_KEY=
TTS_VOICE=mimo_default
TTS_MODEL=mimo-v2.5-tts
TTS_AUDIO_FORMAT=wav
TTS_USE_UPLOAD_PROMPT=false
TTS_PROMPT_AUDIO_PATH=
TTS_RETURN_JSON=true
TTS_TIMEOUT_SECONDS=300
TTS_MAX_RETRIES=1
ASR_PROVIDER=XIAOMI
ASR_API_URL=https://api.xiaomimimo.com/v1
ASR_API_KEY=
ASR_APP_ID=
ASR_MODEL=mimo-v2.5-asr
# QQ SMTP：密码填写邮箱授权码，不是网页登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION_REQUIRED=true
GENERATION_CONCURRENCY=30
BACKGROUND_TASK_TIMEOUT_SECONDS=1200
HTTP_RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=12
AI_REQUEST_RATE_LIMIT_PER_MINUTE=20
GRAPHQL_MAX_BODY_BYTES=16777216
MEDIA_PROXY_MAX_BYTES=20971520
ANALYTICS_ENABLED=true
ANALYTICS_TIMEZONE=Asia/Shanghai
ANALYTICS_ADMIN_TOKEN=REPLACE_WITH_A_SECOND_LONG_RANDOM_SECRET
BILLING_ENABLED=true
BILLING_FREE_DAILY_CREDITS=20
BILLING_TIMEZONE=Asia/Shanghai
EPAY_GATEWAY_URL=https://your-payment-gateway.example.com/submit.php
EPAY_MERCHANT_ID=
EPAY_KEY=
EPAY_NOTIFY_URL=https://api.example.com/payments/easypay/notify
EPAY_DEFAULT_CHANNEL=wxpay
EPAY_SIGNATURE_MODE=RAW_KEY
# 未接入广告时保持 NONE，前端不会显示广告位。
AD_PROVIDER=NONE
AD_SCRIPT_URL=
AD_COURSE_SLOT=
AD_LIBRARY_SLOT=
AD_RESULT_SLOT=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=linguaquest-media
SENTRY_DSN=