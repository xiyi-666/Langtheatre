# LinguaQuest 小程序版线上环境模板。
# 复制为 infra/.env.mini-program 后填写；不要提交真实文件或任何密钥。
# 本项目的 MINI_PROGRAM 是 H5/多端产品运行模式；若接入微信小程序 WebView，还需在小程序后台配置 HTTPS 业务域名。

DOCKERHUB_USERNAME=jasper177
CLIENT_IMAGE_TAG=mini-program
SERVER_IMAGE_TAG=mini-program

APP_EDITION=MINI_PROGRAM
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_ADDR=linguaquest-redis:6379
RABBITMQ_URL=amqp://guest:guest@linguaquest-rabbitmq:5672/
PUBLIC_APP_URL=https://langquest.cloudaihub.dpdns.org
TRUST_PROXY_HEADERS=true
MEDIA_HOST_PATH=/opt/linguaquest/media

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://apilink.olinkdata.com/v1

TTS_PROVIDER=XIAOMI
TTS_API_URL=https://token-plan-cn.xiaomimimo.com/v1
TTS_API_KEY=
TTS_VOICE=mimo_default
TTS_MODEL=mimo-v2.5-tts
TTS_AUDIO_FORMAT=wav
TTS_TIMEOUT_SECONDS=300
TTS_MAX_RETRIES=1

ASR_PROVIDER=XIAOMI
ASR_API_URL=https://api.xiaomimimo.com/v1
ASR_API_KEY=
ASR_MODEL=mimo-v2.5-asr

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION_REQUIRED=true

# 小程序版免费且无会员/易支付；广告在每日前 3 次 AI 使用后展示。
BILLING_ENABLED=false
MINI_AD_FREE_DAILY_USES=3
MINI_PROGRAM_DAILY_AI_USES=20
MINI_PROGRAM_AI_COOLDOWN_SECONDS=12
MINI_PROGRAM_MAX_ACTIVE_TASKS=2
GENERATION_CONCURRENCY=8
BACKGROUND_TASK_TIMEOUT_SECONDS=1200
HTTP_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_REQUEST_RATE_LIMIT_PER_MINUTE=12
GRAPHQL_MAX_BODY_BYTES=16777216
MEDIA_PROXY_MAX_BYTES=20971520

# 填入已审核的广告联盟脚本和广告位；NONE 时页面会自动隐藏广告。
AD_PROVIDER=NONE
AD_SCRIPT_URL=
AD_COURSE_SLOT=
AD_LIBRARY_SLOT=
AD_RESULT_SLOT=

ANALYTICS_ENABLED=true
ANALYTICS_TIMEZONE=Asia/Shanghai
ANALYTICS_ADMIN_TOKEN=REPLACE_WITH_A_SECOND_LONG_RANDOM_SECRET
SENTRY_DSN=
